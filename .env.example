# Create an API key at https://platform.openai.com/api-keys. Never expose it in the browser.
OPENAI_API_KEY=
# Get a Gemini API key from https://aistudio.google.com/app/apikey.
GEMINI_API_KEY=
# Comma-separated allow lists shown in the client model picker.
OPENAI_MODELS=gpt-6-luna,gpt-6.1-sol,gpt-6-astra
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-pro-preview
# Leave enabled for local setup; disable after creating the accounts you need.
LIBRECHAT_ALLOW_REGISTRATION=true
